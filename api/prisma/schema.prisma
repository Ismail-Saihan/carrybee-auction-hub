datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
}

enum RoleName {
  SUPER_ADMIN
  AUCTION_ADMIN
  AUCTION_MANAGER
  FINANCE
  AUDITOR
  EMPLOYEE
}

enum ItemCondition {
  BRAND_NEW
  OPEN_BOX
  REFURBISHED
  GOOD
  FAIR
  SALVAGE
}

enum ItemStatus {
  INSPECTED
  LISTED
  SOLD
  RETURNED
  SCRAPPED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  SETTLEMENT_PENDING
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  READY_FOR_COLLECTION
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum BidStatus {
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SettlementStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  READY_FOR_COLLECTION
  COMPLETED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  clerkId      String         @unique
  email        String         @unique
  status       UserStatus     @default(ACTIVE)
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  employeeId   String?        @unique
  employee     Employee?
  bids         Bid[]
  notifications Notification[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

model Employee {
  id               String           @id @default(cuid())
  employeeId       String           @unique
  displayName      String
  department       String
  designation      String
  email            String           @unique
  phone            String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  isEligibleToBid  Boolean          @default(true)
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([department])
  @@index([employmentStatus, isEligibleToBid])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  category    String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuctionCategory {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  icon        String?
  items       AuctionItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuctionItem {
  id               String          @id @default(cuid())
  lotNumber        String          @unique
  title            String
  description      String
  categoryId       String
  category         AuctionCategory @relation(fields: [categoryId], references: [id])
  condition        ItemCondition   @default(GOOD)
  recommendedPrice Decimal         @db.Decimal(12, 2)
  status           ItemStatus      @default(INSPECTED)
  images           String[]
  operationalNotes String?
  auctions         Auction[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Auction {
  id                    String        @id @default(cuid())
  auctionNumber         String        @unique
  itemId                String
  item                  AuctionItem   @relation(fields: [itemId], references: [id])
  status                AuctionStatus @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  startingBid           Decimal       @db.Decimal(12, 2)
  currentBid            Decimal       @default(0) @db.Decimal(12, 2)
  minIncrement          Decimal       @default(500) @db.Decimal(12, 2)
  bidCount              Int           @default(0)
  antiSnipingEnabled    Boolean       @default(true)
  antiSnipingWindowSec  Int           @default(120)
  antiSnipingExtendSec  Int           @default(120)
  paymentDeadlineHours  Int           @default(48)
  allowedPaymentMethods String[]      @default(["BANK_TRANSFER", "BKASH", "PAYROLL_DEDUCTION"])
  collectionLocation    String        @default("CarryBee Central Hub, Tejgaon, Dhaka")
  createdById           String?
  bids                  Bid[]
  settlement            Settlement?
  payments              Payment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, endsAt])
  @@index([status, startsAt])
}

model Bid {
  id              String       @id @default(cuid())
  auctionId       String
  auction         Auction      @relation(fields: [auctionId], references: [id])
  bidderId        String
  bidder          User         @relation(fields: [bidderId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  sequence        Int
  placedAt        DateTime     @default(now())
  status          BidStatus    @default(ACCEPTED)
  rejectionReason String?
  idempotencyKey  String?      @unique
  settlementsWon  Settlement[]

  @@index([auctionId, sequence])
  @@index([auctionId, placedAt])
  @@index([bidderId, placedAt])
}

model Payment {
  id                String        @id @default(cuid())
  auctionId         String
  auction           Auction       @relation(fields: [auctionId], references: [id])
  settlementId      String
  settlement        Settlement    @relation(fields: [settlementId], references: [id])
  payerId           String
  amount            Decimal       @db.Decimal(12, 2)
  paymentMethod     String
  transactionRef    String?
  status            PaymentStatus @default(PENDING)
  verifiedById      String?
  verifiedAt        DateTime?
  notes             String?
  proofAttachmentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([auctionId])
  @@index([settlementId])
}

model Settlement {
  id                 String           @id @default(cuid())
  auctionId          String           @unique
  auction            Auction          @relation(fields: [auctionId], references: [id])
  winningBidId       String
  winningBid         Bid              @relation(fields: [winningBidId], references: [id])
  winnerId           String
  finalAmount        Decimal          @db.Decimal(12, 2)
  status             SettlementStatus @default(PENDING)
  paymentDeadline    DateTime
  collectionLocation String
  notes              String?
  payments           Payment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, paymentDeadline])
  @@index([winnerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  url          String
  uploaderId   String?
  targetType   String?
  targetId     String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}
