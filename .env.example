# ==============================================================================
# CarryBee Auction Hub — Root Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# Copy this file to `.env.local` for Next.js, and `api/.env` for NestJS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Next.js Browser & Server Accessible)
# Prefix client variables with NEXT_PUBLIC_ so they can be exposed safely.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Clerk Client-Safe Authentication Key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER_PUBLISHABLE_KEY

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NestJS Backend & Server Functions Only)
# Never prefix these with NEXT_PUBLIC_ and never expose to client bundles.
# ------------------------------------------------------------------------------

# Runtime Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Clerk Authentication (Server Secrets)
CLERK_SECRET_KEY=sk_test_PLACEHOLDER_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_PLACEHOLDER_WEBHOOK_SECRET

# PostgreSQL Database (Authoritative datastore)
POSTGRES_USER=carrybee_admin
POSTGRES_PASSWORD=carrybee_secret_2026
POSTGRES_DB=carrybee_auction
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carrybee_admin:carrybee_secret_2026@localhost:5432/carrybee_auction?schema=public

# Redis (Realtime coordination & BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage / MinIO (S3-compatible)
MINIO_ROOT_USER=carrybee_minio_admin
MINIO_ROOT_PASSWORD=carrybee_minio_secret_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=carrybee_minio_admin
S3_SECRET_KEY=carrybee_minio_secret_2026
S3_BUCKET_NAME=carrybee-auctions
S3_USE_SSL=false

# Optional: Email Service Provider (Future Phase)
# RESEND_API_KEY=re_PLACEHOLDER_KEY
# EMAIL_FROM=auction-notifications@carrybee.com
